@model IEnumerable<CurrencyPairDto>
@{
    ViewData["Title"] = "Live Currency Pairs";
}

<div class="mb-4">
    <h1 class="display-6">Live Currency Pairs</h1>
    <p class="text-muted">Initial prices are loaded from the server. Future updates will arrive via SignalR.</p>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle" id="currency-pairs-table">
        <thead class="table-dark">
            <tr>
                <th scope="col">Pair</th>
                <th scope="col" class="text-end">Current Price</th>
                <th scope="col" class="text-end">Min</th>
                <th scope="col" class="text-end">Max</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pair in Model)
            {
                <tr id="pair-@pair.Id">
                    <td class="pair-name">@pair.DisplayName</td>
                    <td class="text-end price">@pair.CurrentValue.ToString("F4")</td>
                    <td class="text-end min">@pair.MinValue.ToString("F4")</td>
                    <td class="text-end max">@pair.MaxValue.ToString("F4")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/trading-ui.js" asp-append-version="true"></script>
    <script src="~/js/trading-signalr.js" asp-append-version="true"></script>
}
